<Window x:Class="ApproachR10Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approach R10 Windows" Height="720" Width="1100"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Approach R10" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Windows launch-monitor dashboard" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#6B7280" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Paired R10:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DeviceCombo" Width="270" Height="32" DisplayMemberPath="Name"/>
                    <Button x:Name="ScanButton" Content="Scan paired devices" Click="ScanButton_Click" Margin="10,0,0,0" Padding="14,5"/>
                    <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" Margin="10,0,0,0" Padding="18,5"/>
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click" Margin="10,0,0,0" Padding="14,5" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="DeviceInfo" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Latest shot" FontSize="20" FontWeight="SemiBold"/>
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,18">
                        <StackPanel><TextBlock Text="Ball speed" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BallSpeed" Text="—" FontSize="25" FontWeight="Bold"/></StackPanel>
                        <StackPanel><TextBlock Text="Carry / total" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Distance" Text="—" FontSize="25" FontWeight="Bold"/></StackPanel>
                        <StackPanel><TextBlock Text="Launch" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Launch" Text="—" FontSize="25" FontWeight="Bold"/></StackPanel>
                        <StackPanel><TextBlock Text="Spin" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="Spin" Text="—" FontSize="25" FontWeight="Bold"/></StackPanel>
                    </UniformGrid>
                    <DataGrid Grid.Row="2" x:Name="ShotsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#111827" Foreground="#111827" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="50"/>
                            <DataGridTextColumn Header="Ball mph" Binding="{Binding BallSpeed}" Width="90"/>
                            <DataGridTextColumn Header="Club mph" Binding="{Binding ClubSpeed}" Width="90"/>
                            <DataGridTextColumn Header="Carry" Binding="{Binding Carry}" Width="90"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="90"/>
                            <DataGridTextColumn Header="Launch" Binding="{Binding LaunchAngle}" Width="80"/>
                            <DataGridTextColumn Header="HLA" Binding="{Binding LaunchDirection}" Width="70"/>
                            <DataGridTextColumn Header="Spin" Binding="{Binding Spin}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="R10 state" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Ready" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="ReadyText" Text="—" FontSize="22" Margin="0,2,0,14"/>
                    <TextBlock Text="Model" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="ModelText" Text="—" FontSize="18" Margin="0,2,0,14"/>
                    <TextBlock Text="Firmware" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="FirmwareText" Text="—" FontSize="18" Margin="0,2,0,14"/>
                    <TextBlock Text="Battery" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="BatteryText" Text="—" FontSize="18" Margin="0,2,0,14"/>
                    <TextBlock Text="Log" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/>
                    <TextBox x:Name="LogBox" Height="260" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111827" Foreground="#D1D5DB" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
